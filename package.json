{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node --max-http-header-size=163840 dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "docker:build": "docker build -t interview-coach:latest .",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "db:list": "tsx --env-file=.env scripts/db-admin.ts list",
    "db:clear": "tsx --env-file=.env scripts/db-admin.ts clear",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:providers": "node --env-file-if-exists=.env --import tsx --test tests/providers.live.test.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "benchmark:voice": "node --env-file-if-exists=.env --import tsx scripts/benchmark-voice.ts",
    "staff:provision": "node --env-file-if-exists=.env --import tsx scripts/provision-staff.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.7.4",
    "motion": "^12.23.24",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
